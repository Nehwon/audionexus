# Configuration de développement - SQLite par défaut
ENVIRONMENT=development
DEBUG=true

# Base de données SQLite
DB_TYPE=sqlite
SQLITE_PATH=./audionexus_dev.db

# Clés de développement (pas pour la production !)
SECRET_KEY=dev-secret-key-change-me-in-production
JWT_SECRET=dev-jwt-secret-change-me-too

# Audiobookshelf
ABS_API_URL=http://localhost:13378/api
ABS_USERNAME=admin
ABS_PASSWORD=admin

# VoidAuth
VOIDAUTH_SERVER_URL=http://localhost:8080
VOIDAUTH_REALM=master
VOIDAUTH_CLIENT_ID=audionexus-dev
VOIDAUTH_CLIENT_SECRET=dev-secret
VOIDAUTH_ADMIN_USER=admin
VOIDAUTH_ADMIN_PASSWORD=admin
BACKEND_CORS_ORIGINS='["http://localhost:3000"]'