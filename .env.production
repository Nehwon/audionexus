# Configuration de production - MySQL obligatoire
ENVIRONMENT=production
DEBUG=false

# Base de données MySQL
DB_TYPE=mysql
DB_HOST=db
DB_PORT=3306
DB_USER=audionexus
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_NAME=audionexus

# Clés de production (À CHANGER ABSOLUMENT !)
SECRET_KEY=YOUR_PRODUCTION_SECRET_KEY_HERE
JWT_SECRET=YOUR_PRODUCTION_JWT_SECRET_HERE

# Audiobookshelf
ABS_API_URL=http://abs:13378/api
ABS_USERNAME=admin
ABS_PASSWORD=YOUR_ABS_PASSWORD_HERE

# VoidAuth
VOIDAUTH_SERVER_URL=http://voidauth:8080
VOIDAUTH_REALM=audionexus
VOIDAUTH_CLIENT_ID=audionexus-backend
VOIDAUTH_CLIENT_SECRET=YOUR_PRODUCTION_CLIENT_SECRET_HERE
VOIDAUTH_ADMIN_USER=admin
VOIDAUTH_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# Network
BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
API_V1_STR=/api/v1

# Storage
UPLOAD_FOLDER=/app/data/uploads
STATIC_FOLDER=/app/static