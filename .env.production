# Configuration de production - MySQL obligatoire
ENVIRONMENT=production
DEBUG=false

# Base de données MySQL
DB_TYPE=mysql
DB_HOST=db
DB_PORT=3306
DB_USER=audionexus
DB_PASSWORD=secure_db_password_2024!
DB_NAME=audionexus

# Clés de production (PLACEHOLDERS - À CHANGER EN PRODUCTION !)
SECRET_KEY=secure_secret_key_2024_production!
JWT_SECRET=secure_jwt_secret_2024_production!

# Audiobookshelf
ABS_API_URL=http://abs:13378/api
ABS_USERNAME=admin
ABS_PASSWORD=secure_abs_password_2024!

# VoidAuth
VOIDAUTH_SERVER_URL=http://voidauth:8080
VOIDAUTH_REALM=audionexus
VOIDAUTH_CLIENT_ID=audionexus-backend
VOIDAUTH_CLIENT_SECRET=secure_client_secret_2024!
VOIDAUTH_ADMIN_USER=admin
VOIDAUTH_ADMIN_PASSWORD=secure_admin_password_2024!

# Network
BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
API_V1_STR=/api/v1

# Storage
UPLOAD_FOLDER=/app/data/uploads
STATIC_FOLDER=/app/static