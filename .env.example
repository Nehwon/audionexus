# Configuration du serveur Audiobookshelf
AUDIOBOOKSHELF_URL=http://localhost:13378
AUDIOBOOKSHELF_USERNAME=admin
AUDIOBOOKSHELF_PASSWORD=votre_mot_de_passe

# Configuration de l'application
APP_SECRET_KEY=votre_clé_secrète_ici
DATABASE_URL=sqlite:///./sql_app.db

# Configuration du stockage
STORAGE_PATH=./data/audiobooks
TEMP_PATH=./temp

# Configuration du serveur web
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Configuration des emails
MAIL_ENABLED=False
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=votre_email@example.com
MAIL_PASSWORD=votre_mot_de_passe
MAIL_DEFAULT_SENDER=noreply@example.com
FRONTEND_URL=http://localhost:3000

# Configuration HTTPS (optionnel)
# SSL_CERTFILE=/chemin/vers/cert.pem
# SSL_KEYFILE=/chemin/vers/key.pem
