# AudioNexus Environment Configuration Template
# Copy this file to .env.development or .env and fill in your values

# Security Configuration - Change these for production!
SECRET_KEY=your-secure-random-secret-key-here
ALGORITHM=HS256

# Database Configuration
DB_HOST=database
DB_PORT=3306
DB_NAME=audionexus_dev
DB_USER=audionexus
DB_PASSWORD=your_secure_db_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_HOST=redis-cache

# Audiobookshelf Configuration
# Replace with your actual Audiobookshelf server details
AUDIobookSHELF_BASE_URL=http://audiobookshelf:13378
AUDIobookSHELF_API_KEY=your-audiobookshelf-api-key-here

# Email Configuration
# For development, keep this as False
EMAIL_BACKEND=False

# Flask/Application Configuration
FLASK_APP=wsgi:app
FLASK_ENV=development
FLASK_DEBUG=1

# HTTP Server Configuration
FORWARDED_ALLOW_IPS=*
PROXY_ALLOW_IPS=*

# Logging
LOG_LEVEL=DEBUG

# Security Note:
# To generate a secure SECRET_KEY, run:
# openssl rand -hex 32
#
# Or for Python:
# python -c "import secrets; print(secrets.token_hex(32))"
