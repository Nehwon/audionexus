# Configuration AudioNexus - Exemple de variables d'environnement
# Copiez ce fichier vers .env et ajustez les valeurs selon vos besoins

# === ENVIRONNEMENT ===
# Valeurs possibles: development, testing, production
ENVIRONMENT=development

# Mode test (sera automatiquement défini par les scripts de test)
# TESTING=false

# === BASE DE DONNÉES ===
# Type de base de données (sqlite/mysql)
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=audionexus
DB_PASSWORD=audionexus
DB_NAME=audionexus

# Chemin du fichier SQLite (uniquement pour SQLite)
SQLITE_PATH=./audionexus.db

# URI de base de données personnalisée (optionnel, remplace la configuration ci-dessus)
# DATABASE_URL=sqlite+aiosqlite:///./audionexus.db

# === SÉCURITÉ ===
# Clés secrètes (changez-les en production !)
SECRET_KEY=changez-moi-en-production
JWT_SECRET=changez-moi-aussi
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# === AUDIOBOOKSHELF ===
ABS_API_URL=http://localhost:13378/api
ABS_USERNAME=admin
ABS_PASSWORD=admin

# === VOIDAUTH (OIDC) ===
VOIDAUTH_SERVER_URL=http://localhost:8080
VOIDAUTH_REALM=audionexus
VOIDAUTH_CLIENT_ID=audionexus-backend
VOIDAUTH_CLIENT_SECRET=your-client-secret-here
VOIDAUTH_ADMIN_USER=admin
VOIDAUTH_ADMIN_PASSWORD=your-admin-password-here

# === RÉSEAU ===
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
API_V1_STR=/api/v1

# === STOCKAGE ===
UPLOAD_FOLDER=./uploads
STATIC_FOLDER=./static

# === DEBUG ===
DEBUG=true
