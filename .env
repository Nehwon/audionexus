# Configuration de l'application
APP_ENV=development
DEBUG=true

# Base de données (SQLite pour les tests)
DATABASE_URL=sqlite+aiosqlite:///./audionexus.db
TEST_DATABASE_URL=sqlite+aiosqlite:///./test_audionexus.db

# Sécurité
SECRET_KEY=votre_cle_secrete_tres_longue_et_securisee
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Configuration de l'API
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Configuration JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Configuration de la base de données Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Configuration du stockage
STORAGE_PATH=./data/audionexus
TEMP_PATH=./temp
UPLOAD_FOLDER=./data/audionexus/uploads

# Configuration du serveur web
HOST=0.0.0.0
PORT=8000

# Configuration du reverse proxy (Nginx)
VIRTUAL_HOST=localhost
VIRTUAL_PORT=8000

# Configuration pour le développement (à désactiver en production)
DEBUG=True
RELOAD=True

# Configuration du serveur Audiobookshelf (optionnel)
AUDIOBOOKSHELF_URL=http://localhost:13378
AUDIOBOOKSHELF_USERNAME=
AUDIOBOOKSHELF_PASSWORD=

# Configuration Certbot (optionnel, pour la production)
CERTBOT_EMAIL=
DOMAIN_NAME=
