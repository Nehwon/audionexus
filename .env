# Configuration de la base de données
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=audionexus
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Configuration de l'application
APP_SECRET_KEY=changez_ceci_par_une_clé_secrète_plus_sécurisée
APP_DEBUG=True
APP_ENV=development

# Configuration de l'API
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Configuration JWT
SECRET_KEY=changez_ceci_par_une_clé_secrète_plus_sécurisée
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520  # 8 jours (60 * 24 * 8)

# Configuration de la base de données Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Configuration du stockage
STORAGE_PATH=./data/audionexus
TEMP_PATH=./temp
UPLOAD_FOLDER=./data/audionexus/uploads

# Configuration du serveur web
HOST=0.0.0.0
PORT=8000

# Configuration du reverse proxy (Nginx)
VIRTUAL_HOST=localhost
VIRTUAL_PORT=8000

# Configuration pour le développement (à désactiver en production)
DEBUG=True
RELOAD=True

# Configuration du serveur Audiobookshelf (optionnel)
AUDIOBOOKSHELF_URL=http://localhost:13378
AUDIOBOOKSHELF_USERNAME=
AUDIOBOOKSHELF_PASSWORD=

# Configuration Certbot (optionnel, pour la production)
CERTBOT_EMAIL=
DOMAIN_NAME=
