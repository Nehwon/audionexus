DB_NAME=audionexus
DB_HOST=db
DB_PORT=3306
DATABASE_URL=mysql+aiomysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Configuration de l'application
APP_SECRET_KEY=changez_ceci_par_une_clé_secrète_plus_sécurisée
APP_DEBUG=True
APP_ENV=development

# Configuration de l'API
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS='["http://localhost:3000"]'

# Configuration JWT
SECRET_KEY=changez_ceci_par_une_clé_secrète_plus_sécurisée
