# Configuration de l'application
APP_ENV=development
DEBUG=true

# Configuration de la base de données MySQL
DB_HOST=db
DB_PORT=3306
DB_NAME=audionexus
DB_USER=audionexus
DB_PASSWORD=c21f68d26c5eb8b9a9cffe3c75fbbc69e6a68d331b1c8896cc96293a982d57e7

# Configuration de l'URL de connexion SQLAlchemy
DATABASE_URL=mysql+aiomysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4

# Configuration de la connexion pour VoidAuth
VOIDAUTH_DATABASE_URL=${DATABASE_URL}
VOIDAUTH_SECRET_KEY=${SECRET_KEY}
VOIDAUTH_JWT_ALGORITHM=${ALGORITHM}

# Configuration de sécurité
SECRET_KEY=c21f68d26c5eb8b9a9cffe3c75fbbc69e6a68d331b1c8896cc96293a982d57e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520
REFRESH_TOKEN_EXPIRE_DAYS=7

# Configuration Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Configuration du stockage
STORAGE_PATH=/app/data/audionexus
TEMP_PATH=/app/temp
UPLOAD_FOLDER=/app/data/audionexus/uploads

# Configuration du serveur web
HOST=0.0.0.0
PORT=8000

# Configuration de l'API
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Configuration du reverse proxy (Nginx)
VIRTUAL_HOST=localhost
VIRTUAL_PORT=8000

# Configuration pour le développement (à désactiver en production)
RELOAD=True

# Configuration du serveur Audiobookshelf (optionnel)
AUDIOBOOKSHELF_URL=http://audionexus-audiobookshelf:13378
AUDIOBOOKSHELF_USERNAME=admin
AUDIOBOOKSHELF_PASSWORD=c21f68d26c5eb8b9a9cffe3c75fbbc69e6a68d331b1c8896cc96293a982d57e7

# Configuration Certbot (optionnel, pour la production)
CERTBOT_EMAIL=
DOMAIN_NAME=
