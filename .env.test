# Configuration de test
# Ce fichier est utilisé pour les tests unitaires et d'intégration

# Configuration de base
DEBUG=True
TESTING=True

# Configuration de la base de données
DATABASE_URI=sqlite+aiosqlite:///:memory:

# Configuration JWT
SECRET_KEY=test-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60  # 1 heure pour les tests

# Désactive la vérification SSL pour les tests
VERIFY_SSL=False

# Désactive les notifications par email dans les tests
SEND_EMAILS=False
